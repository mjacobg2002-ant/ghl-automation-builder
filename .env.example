# Copy to .env for manual local testing (`node --env-file=.env ...`).
# When running via an MCP client (Claude Code/Desktop), set these in the
# server's `env` block in its config instead -- see README.md "Running Locally".
# Never commit a real .env file; it's already gitignored.

# Required. Long-lived Firebase refresh token for the GHL internal API.
# See docs/auth.md "Extracting a New Refresh Token".
GHL_FIREBASE_REFRESH_TOKEN=

# Optional. Pre-fill so tools can omit `locationId`.
DEFAULT_LOCATION_ID=

# Optional overrides -- defaults match wrangler.toml.
# FIREBASE_API_KEY=AIzaSyB_w3vXmsI7WeQtrIOkjR6xTRVN5uOieiE
# FIREBASE_PROJECT_ID=highlevel-backend
# GHL_INTERNAL_BASE_URL=https://backend.leadconnectorhq.com
# KV_TOKEN_KEY=ghl_firebase_id_token
# KV_TOKEN_TTL_SECONDS=3300

# Optional. Where the local token cache file lives. Default: ~/.ghl-workflow-mcp
# GHL_MCP_CACHE_DIR=
